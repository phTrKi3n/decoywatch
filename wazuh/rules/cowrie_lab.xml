<group name="cowrie_lab,">
  <rule id="100110" level="7">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.login\.success$</field>
    <protocol>ssh</protocol>
    <description>Cowrie ghi nhận đăng nhập SSH vào bẫy</description>
    <options>no_full_log</options>
  </rule>
  <rule id="100111" level="5">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.login\.failed$</field>
    <protocol>ssh</protocol>
    <description>Cowrie ghi nhận đăng nhập SSH thất bại</description>
    <options>no_full_log</options>
  </rule>
  <rule id="100112" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100111</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Phát hiện tấn công vét cạn SSH vào bẫy Cowrie</description>
    <options>no_full_log</options>
  </rule>
  <rule id="100115" level="9">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.(command\.input|session\.file_download)$</field>
    <description>Phát hiện thao tác hậu khai thác trong bẫy Cowrie</description>
    <options>no_full_log</options>
  </rule>
  <rule id="100120" level="7">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^lab\.firewall\.scan$</field>
    <description>Phát hiện dấu hiệu dò quét vào WAN mô phỏng</description>
    <options>no_full_log</options>
  </rule>
</group>
